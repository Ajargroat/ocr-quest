# Konkour OCR pipeline — configuration template.
# Copy to .env and fill in the secrets, or run start.bat which does the copy for you.

# --- Input tree -------------------------------------------------------------
# Folder the converter watches and the scanner reads:
#   {subject}/{grade}/{topic}/{question|answer}/{file}
# Leave unset to use the konkour-ocr folder that ships next to main.py.
# INPUT_ROOT=E:\OCR-quest\konkour-ocr

# Ignore files modified less than this many seconds ago (lets the converter
# finish writing JPEGs before the scanner picks them up).
MIN_AGE_SECONDS=30

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=konkour-pages

# --- Postgres ---------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Blank = the driver default (today's behaviour). Set require/disable/…
# when the target is a managed or local TLS Postgres.
POSTGRES_SSLMODE=

# --- Gemini (OCR extraction) ------------------------------------------------
# One shared key, or per-branch keys to split quota/routing.
GEMINI_API_KEY=
GEMINI_API_KEY_QUESTIONS=
GEMINI_API_KEY_ANSWERS=
GEMINI_MODEL_QUESTIONS=gemini-2.5-flash
GEMINI_MODEL_ANSWERS=gemini-2.5-flash

# --- Resilience behind the tunnel -------------------------------------------
# How many times a transient fault (tunnel blip, 429 rate limit, 5xx overload)
# is retried per call; the base seconds of the first wait (waits grow
# exponentially — base, 2×base, 4×base… — up to NET_RETRY_CAP); permanent
# faults (bad key, geo block, daily quota) fail fast without burning retries.
# A free-quota-exhausted model is skipped until the next UTC midnight reset.
NET_RETRIES=3
NET_RETRY_WAIT=5
NET_RETRY_CAP=120
# If requests does not pick up your tunnel automatically, point it here, e.g.
# the local HTTP port of v2rayN/Outline:
# HTTPS_PROXY=http://127.0.0.1:10808

# --- Dashboard --------------------------------------------------------------
HOST=0.0.0.0
PORT=8080

# --- Revision audit router (OpenAI-compatible) ------------------------------
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=
ROUTER_MODEL=OCR-Quest
REVISION_BATCH_LIMIT=40
REVISION_CHUNK_SIZE=8

# --- Saved custom providers (one kind: label · base URL · API key · model) ---
# Written by the Credentials tab as a JSON array. EXTRACTION_ACTIVE="" means
# the Gemini key pool is the extraction engine; an empty REVISION_ACTIVE
# means no revision endpoint is selected yet.
# Legacy ROUTER_* / OCR_* / GEMINI_API_KEY* are still read when these are
# absent, so an older .env keeps working unchanged.
EXTRACTION_PROVIDERS=[]
EXTRACTION_ACTIVE=
REVISION_PROVIDERS=[]
REVISION_ACTIVE=

# --- Section enable switches (written by the Credentials tab) ----------------
# 1 = on. A run whose ACTIVE OCR/revision provider is off is blocked at
# pre-flight, with the flag named in the error. Database switches are
# presentation-only (the pipeline keeps its one fixed active connection).
GEMINI_POOL_ENABLED=1
NINEROUTER_ENABLED=1
REVISION_PROVIDER_ENABLED=1
SUPABASE_ENABLED=1
# Extra database connections shown under Supabase — presentation only.
DB_CONNECTIONS=[]

# --- Proxy profiles (pipeline tab) -------------------------------------------
# PROXY_ACTIVE="" is the explicit "Direct (no proxy)" choice.
PROXY_PROFILES=[]
PROXY_ACTIVE=

# --- PDF converter (embedded watcher — starts with the app, no Docker) ------
# CONVERTER_ENABLED=0 turns the watcher off completely.
CONVERTER_ENABLED=1
CONVERTER_DPI=170
CONVERTER_RASTER_QUALITY=78
CONVERTER_MIN_AGE_MINUTES=1
CONVERTER_SCAN_INTERVAL_SECONDS=15

# --- Database tab: weekly snapshots ----------------------------------------
# Every BACKUP_INTERVAL_DAYS the server dumps the five tables (questions,
# answers, sources, revision_reports, revision_summary) into backups/<stamp>/
# as JSON + replayable SQL, keeping only the newest BACKUP_KEEP sets.
# Both knobs are editable here and shown in the Data Console's Backups panel.
BACKUP_INTERVAL_DAYS=7
BACKUP_KEEP=12
