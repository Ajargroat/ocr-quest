# Konkour OCR pipeline — configuration template.
# Copy to .env and fill in the secrets, or run start.bat which does the copy for you.

# --- Input tree -------------------------------------------------------------
# Folder the converter watches and the scanner reads:
#   {subject}/{grade}/{topic}/{question|answer}/{file}
# Leave unset to use the konkour-ocr folder that ships next to main.py.
# INPUT_ROOT=E:\OCR-quest\konkour-ocr

# Ignore files modified less than this many seconds ago (lets the converter
# finish writing JPEGs before the scanner picks them up).
MIN_AGE_SECONDS=30

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=konkour-pages

# --- Postgres ---------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Blank = the driver default (today's behaviour). Set require/disable/…
# when the target is a managed or local TLS Postgres.
POSTGRES_SSLMODE=

# --- Gemini (OCR extraction) ------------------------------------------------
# One shared key, or per-branch keys to split quota/routing.
GEMINI_API_KEY=
GEMINI_API_KEY_QUESTIONS=
GEMINI_API_KEY_ANSWERS=
GEMINI_MODEL_QUESTIONS=gemini-2.5-flash
GEMINI_MODEL_ANSWERS=gemini-2.5-flash
# Ordered ladder (cheapest first) + enabled subset (absent = all on).
# GEMINI_MODEL_LADDER=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash
# GEMINI_MODELS_ENABLED=gemini-3.5-flash-lite
# per-model RPD overrides (flash-lite is 500/day; the rest use GEMINI_MODEL_DAY_LIMIT)
# GEMINI_MODEL_DAY_LIMITS=gemini-3.5-flash-lite:500

# OCR pages per request: 1 = one picture per call (one question at a time),
# 2..8 = the serial pipeline reads that many pages in ONE call and splits the
# reply back onto the pages. The pipeline toolbar's "Pages / call" writes
# this; the Studio has its own STUDIO_PAGES_PER_CALL.
OCR_PAGES_PER_CALL=1

# --- Resilience behind the tunnel -------------------------------------------
# How many times a transient fault (tunnel blip, 429 rate limit, 5xx overload)
# is retried per call; the base seconds of the first wait (waits grow
# exponentially — base, 2×base, 4×base… — up to NET_RETRY_CAP); permanent
# faults (bad key, geo block, daily quota) fail fast without burning retries.
# A free-quota-exhausted model is skipped until the next UTC midnight reset.
NET_RETRIES=3
NET_RETRY_WAIT=5
NET_RETRY_CAP=120
# If requests does not pick up your tunnel automatically, point it here, e.g.
# the local HTTP port of v2rayN/Outline:
# HTTPS_PROXY=http://127.0.0.1:10808

# --- Dashboard --------------------------------------------------------------
HOST=0.0.0.0
PORT=8080

# --- Revision audit router (OpenAI-compatible) ------------------------------
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=
ROUTER_MODEL=OCR-Quest
REVISION_BATCH_LIMIT=40
REVISION_CHUNK_SIZE=8

# --- Saved custom providers (one kind: label · base URL · API key · model) ---
# Written by the Credentials tab as a JSON array. EXTRACTION_ACTIVE="" means
# the Gemini key pool is the extraction engine; an empty REVISION_ACTIVE
# means no revision endpoint is selected yet.
# Legacy ROUTER_* / OCR_* / GEMINI_API_KEY* are still read when these are
# absent, so an older .env keeps working unchanged.
EXTRACTION_PROVIDERS=[]
EXTRACTION_ACTIVE=
REVISION_PROVIDERS=[]
REVISION_ACTIVE=

# --- Section enable switches (written by the Credentials tab) ----------------
# 1 = on. A run whose ACTIVE OCR/revision provider is off is blocked at
# pre-flight, with the flag named in the error. Database switches are
# presentation-only (the pipeline keeps its one fixed active connection).
GEMINI_POOL_ENABLED=1
NINEROUTER_ENABLED=1
REVISION_PROVIDER_ENABLED=1
SUPABASE_ENABLED=1
# Extra database connections shown under Supabase — presentation only.
DB_CONNECTIONS=[]

# --- Studio ----------------------------------------------------------------
# Contiguous PDF pages per extraction request: the text lane bounds by chars,
# the image lane sends pages_per_call images per call (a page is never split).
STUDIO_CHUNK_CHARS=24000
# Pages sent in one vision request - extraction, locate and OCR all read it.
STUDIO_PAGES_PER_CALL=3
# Gemini model for the vision stage ("" -> the router ladder; flash-lite is
# cheap but reads small diagrams less reliably).
# STUDIO_VISION_MODEL=gemini-3.5-flash
# Question bands per figure pass: each band is its own image part.
STUDIO_BAND_BATCH=6
# Re-read a low-confidence text page with the extract model (page image + the
# PDF's own text) instead of trusting the text layer's scrambled order. 0
# turns the pass off for "auto" runs (deterministic anchors only); the Studio
# Extract tab's own organize picker (auto / off / all pages) overrides it per
# run and never needs a restart.
STUDIO_ORGANIZE=1
# Vision pages are capped by pixels, not bytes (a 3000 px q88 page is sharper
# and smaller than a 4968 px q20 one).
STUDIO_VISION_LONG_EDGE=3000
STUDIO_VISION_QUALITY=88
# Defaults to STUDIO_PAGES_PER_CALL when unset (the Extract panel writes both).
STUDIO_CHUNK_IMAGES=3
# Sources live in the folder tree; blank -> <INPUT_ROOT>/studio. The DB points
# at a source by its folder id (sha1 of the tree-relative path).
# STUDIO_SOURCE_ROOT=
# Bucket prefix standalone crops are uploaded under (re-crop = same object id).
STUDIO_CROP_PREFIX=crops

# --- Assistant (the floating help chat) -------------------------------------
# Its OWN OpenAI-compatible endpoint/key/model, never an OCR lane: a chat
# must not spend a Gemini key's quota or disturb a run. A base URL gets
# /chat/completions appended; a full endpoint is used as typed. The key
# never reaches the browser (the server relays the stream).
# ASSISTANT_URL=http://127.0.0.1:20128/v1
# ASSISTANT_API_KEY=
# ASSISTANT_MODEL=gemini/gemini-3.6-flash
#
# Several providers, each with its own key and model list (the settings pop-up
# writes this): a JSON list of {label, base_url, api_key, models}. When it is
# set it wins over the three keys above.
# ASSISTANT_PROVIDERS=[{"label":"9router","base_url":"http://127.0.0.1:20128/v1","api_key":"","models":["gemini/gemini-3.6-flash"]}]
# The active pick, "label::model", and the thinking level sent with a request
# (empty, minimal, low, medium, high).
# ASSISTANT_MODEL=9router::gemini/gemini-3.6-flash
# ASSISTANT_EFFORT=low

# --- Proxy profiles (pipeline tab) -------------------------------------------
# Named proxy profiles now live in a git-ignored local JSON store beside
# .env (.proxy-profiles.json), NOT here — they carry a proxy password and
# are edited from the dashboard. Nothing to set in .env.

# --- PDF converter (embedded watcher — starts with the app, no Docker) ------
# CONVERTER_ENABLED=0 turns the watcher off completely.
CONVERTER_ENABLED=1
CONVERTER_DPI=170
CONVERTER_RASTER_QUALITY=78
CONVERTER_MIN_AGE_MINUTES=1
CONVERTER_SCAN_INTERVAL_SECONDS=15

# --- Database tab: weekly snapshots ----------------------------------------
# Every BACKUP_INTERVAL_DAYS the server dumps the lessons model (courses,
# chapters, lessons, lesson_blocks, media_assets, questions, answers, ...)
# into backups/<stamp>/
# as JSON + replayable SQL, keeping only the newest BACKUP_KEEP sets.
# Both knobs are editable here and shown in the Data Console's Backups panel.
BACKUP_INTERVAL_DAYS=7
BACKUP_KEEP=12
