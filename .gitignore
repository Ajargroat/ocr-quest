# Data Console weekly snapshots — dumps stay inside the project, out of git
backups/

# Per-day successful-send counters for the Credentials usage bars (hashed
# key ids only, but it is machine-local telemetry — never worth committing)
.gemini-usage.json

# Per-call usage history (ts, model, tokens, ms, masked key) behind the
# credentials usage reports — same machine-local telemetry, never committed
.gemini-calls.json

# When each Gemini key was first saved (hashed ids only) — local, never committed
.gemini-key-meta.json

# Pipeline write-cache: extracted results that Postgres could not accept yet,
# re-imported automatically at the end of the next run
.pending-deferrals.json
.pending-deferrals.json.corrupt

# Rasterised OCR input tree — local working data, regenerated by the converter
# (pipeline scans it at runtime; the tracked copy in git is stale and noisy)
konkour-ocr/

# scratch log kept open by the detached test server
tools/_srv.log

# Local secrets (start.bat recreates .env from the tracked .env.example)
.env

# Python
__pycache__/
*.pyc
.venv/

# Agent workflow state (local-only per checkout, same convention as Sapienstech)
/.agent
/AGENTS.md
/.claude
